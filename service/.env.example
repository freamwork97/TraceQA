# Operator-only values. Never send these to customers or add to frontend code.
SERVICE_TOKEN=replace-with-32-or-more-random-characters
SITE_ORIGIN=https://traceqa-explorer-kr.jsy11123.chatgpt.site
DATABASE_PATH=/data/traceqa.sqlite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RUN_TIMEOUT_MINUTES=30
# Optional: comma-separated exact target hostnames. Empty means public IPv4 targets.
TARGET_HOSTS=
# Toss Payments API individual integration test keys (matching pair).
# Payment widget test_gck/test_gsk keys are not used by this card-window integration.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Operator decides the sale amount in KRW and credits per one-time pack.
CREDIT_PACK_AMOUNT_KRW=
CREDIT_PACK_CREDITS=
